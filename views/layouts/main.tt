<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="OpenStack Academy: practical open-source technology education.">
  <title>OpenStack Academy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">OpenStack Academy</a>
      <nav aria-label="Main navigation"><a href="/">Lessons</a></nav>
    </div>
  </header>
  <main class="container" id="main-content">
    <% content %>
  </main>
  <footer class="site-footer">
    <div class="container">Independent open-source education project. Not affiliated with or endorsed by OpenStack or the OpenInfra Foundation.</div>
  </footer>
</body>
</html>
