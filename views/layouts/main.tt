<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Bosnatron Academy: practical open-source technology education.">
  <meta name="theme-color" content="#080A0B">
  <title>Bosnatron Academy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="terminal-theme">
  <div class="sunlight" aria-hidden="true"></div>
  <svg id="gearField" class="gear-field" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"></svg>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">Bosnatron Academy</a>
    </div>
  </header>
  <main class="container" id="main-content">
    <% content %>
    <% IF previous_page || next_page %>
    <nav class="lesson-navigation" aria-label="Lesson navigation">
      <% IF previous_page %><a class="academy-nav-button lesson-previous" href="<% previous_page %>" rel="prev">← Previous</a><% END %>
      <% IF next_page %><a class="academy-nav-button lesson-next" href="<% next_page %>" rel="next"><% IF last_lesson %>Finish · Home<% ELSE %>Next<% END %> →</a><% END %>
    </nav>
    <% END %>
  </main>
  <footer class="site-footer">
    <div class="container">© 2026 Bosnatron Academy · <a href="/license.html">Copyright and licenses</a></div>
  </footer>
  <img class="slackware-penguin" src="/images/slackware-mascot.svg" width="512" height="594" alt="Tux penguin">
  <div id="creditMagnifier" class="magnifier" aria-hidden="true"><p id="magnifiedCredit" class="magnified-credit"></p></div>
  <script src="/js/terminal-theme.js" defer></script>
</body>
</html>
