<title>Dancer2 – web aplikacije u Perlu | OpenStack Academy</title>
<link rel="stylesheet" href="/css/bootstrap.min.css">
<style>body{background:#ad865c;color:#24324a;font-family:system-ui,-apple-system,sans-serif;line-height:1.7}.academy{max-width:880px;margin:40px auto;padding:0 20px}.lesson{background:#ad865c;border-radius:16px;padding:clamp(24px,5vw,48px);box-shadow:0 8px 30px #19315214}.top{margin-bottom:24px}.top a,.links a{color:#175caa}h1{font-size:2.3rem;margin:0 0 16px}h2{font-size:1.45rem;margin-top:34px;color:#174d83}p{font-size:1.05rem}pre{background:#162235;color:#eef6ff;border-radius:10px;padding:18px;overflow-x:auto;line-height:1.5}pre code{color:inherit;background:none;padding:0;white-space:pre}code{background:#edf2f7;border-radius:4px;padding:2px 5px}nav.links{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px;padding-top:20px;border-top:1px solid #e4eaf2}nav.links a{padding:6px 12px;background:#edf4fc;border-radius:8px}nav.links a[aria-current=page]{font-weight:700;background:#d6e7fa}@media(max-width:600px){.academy{margin:16px auto}.lesson{padding:22px}h1{font-size:1.9rem}}</style>
